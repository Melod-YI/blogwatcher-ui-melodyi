{{define "blog-edit-form.gohtml"}}
<div class="blog-settings-card blog-edit-mode" id="blog-{{.Blog.ID}}">
    <form class="blog-edit-form"
          hx-put="/blogs/{{.Blog.ID}}"
          hx-target="#blog-{{.Blog.ID}}"
          hx-swap="outerHTML">
        <div class="blog-edit-input">
            <input type="text" name="name" value="{{.Blog.Name}}"
                   maxlength="100" required autofocus
                   placeholder="Blog name">
        </div>

        <!-- Blog URL -->
        <div class="blog-edit-url">
            <label class="edit-label">Blog URL</label>
            <input type="url" name="url" value="{{.Blog.URL}}"
                   pattern="^https?://.*"
                   placeholder="https://example.com">
            <span class="url-error-message">URL 必须以 http:// 或 https:// 开头</span>
        </div>

        <!-- Feed URL -->
        <div class="blog-edit-feed-url">
            <label class="edit-label">Feed URL</label>
            <input type="url" name="feed_url" value="{{.Blog.FeedURL}}"
                   pattern="^https?://.*"
                   placeholder="https://example.com/feed.xml">
            <span class="url-error-message">URL 必须以 http:// 或 https:// 开头</span>
        </div>

        <!-- Category dropdown (refreshes when new categories are created) -->
        <div class="blog-edit-category">
            <select name="category_id"
                    hx-trigger="categoryListUpdated from:body"
                    hx-get="/blogs/{{.Blog.ID}}/edit"
                    hx-target="#blog-{{.Blog.ID}}"
                    hx-swap="outerHTML">
                <option value="">-- 未分类 --</option>
                {{range .Categories}}
                <option value="{{.ID}}"
                        {{if eq $.Blog.CategoryID .ID}}selected{{end}}>
                    {{.Name}}
                </option>
                {{end}}
            </select>
        </div>

        <div class="blog-edit-actions">
            <button type="submit" class="btn-action btn-save">Save</button>
            <button type="button" class="btn-action btn-cancel"
                    hx-get="/blogs/{{.Blog.ID}}"
                    hx-target="#blog-{{.Blog.ID}}"
                    hx-swap="outerHTML">
                Cancel
            </button>
        </div>
    </form>
</div>
{{end}}
