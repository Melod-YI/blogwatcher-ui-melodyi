{{define "settings-page.gohtml"}}
<div class="main-content-header">
    <header class="main-header">
        <h1>Settings</h1>
    </header>
</div>
<div class="main-content-body">
    {{if .PreviewSuccess}}
    <div class="success-message preview-success">
        <p><strong>Successfully added '{{.PreviewBlogName}}'</strong></p>
        {{if .PreviewFeedURL}}
        <p class="feed-url-info">Feed: {{.PreviewFeedURL}}</p>
        {{end}}
        <p class="sync-info">Articles are being fetched in the background. You can navigate away safely.</p>
    </div>
    {{end}}
    {{template "add-blog-form.gohtml" .}}

    <!-- Category management section (shown before Tracked Blogs per D-01) -->
    {{template "category-section.gohtml" .}}

    <section class="settings-section">
        <h2>Tracked Blogs</h2>
        {{if .SettingsBlogs}}
        <div class="blog-settings-list">
            {{range .SettingsBlogs}}
            {{template "blog-display-row.gohtml" .}}
            {{end}}
        </div>
        {{else}}
        <p class="empty-state">No blogs tracked yet.</p>
        {{end}}
    </section>
</div>
{{end}}
