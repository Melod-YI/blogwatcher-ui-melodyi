{{define "category-add-form.gohtml"}}
<div class="category-item category-add-mode" id="category-add-form">
    <form class="category-edit-form"
          hx-post="/categories"
          hx-target="#category-add-form"
          hx-swap="outerHTML"
          hx-on::after-settle="document.querySelector('.btn-add-category').style.display = ''">
        <div class="category-edit-input">
            <input type="text" name="name"
                   maxlength="100" required autofocus
                   placeholder="Category name">
        </div>
        <div class="category-edit-actions">
            <button type="submit" class="btn-action btn-save">Save</button>
            <button type="button" class="btn-action btn-cancel"
                    onclick="this.closest('#category-add-form').remove(); document.querySelector('.btn-add-category').style.display = ''">
                Cancel
            </button>
        </div>
    </form>
</div>
{{end}}